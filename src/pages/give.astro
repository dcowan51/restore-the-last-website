---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateButton from '../components/DonateButton.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import projects from '../data/projects.json';
---

<BaseLayout title="Give" description="Every dollar reaches the field. Give to the fund that puts neurofeedback in the hands of the people who need it most.">

  <!-- Hero -->
  <section class="bg-white section-padding border-b border-primary/10">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Give</p>
      <div class="gold-line mb-8"></div>
      <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight max-w-3xl">
        Every dollar reaches the field.
      </h1>
      <p class="text-body text-lg max-w-2xl mt-6 leading-relaxed">
        Your gift goes into one fund — and straight back out to the facilities doing the work. We deploy it where the need is most urgent, name every project it touches, and report what changed.
      </p>
      <div class="mt-8">
        <DonateButton label="Donate now" class="btn-gold text-lg" />
      </div>
    </div>
  </section>

  <!-- How Giving Works -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <div class="max-w-3xl">
        <p class="label text-primary mb-6">How Giving Works</p>
        <h2 class="mb-8">One fund. Named destinations. Real reports.</h2>
        <p class="text-body text-lg leading-relaxed mb-8">
          We pool giving into a single fund so we can move fast when a facility is ready. That's the difference between a machine sitting in a closet and a machine running sessions next month. What doesn't change is the accounting — every project the fund touches is named publicly, with outcomes attached.
        </p>
        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">You give to the fund</h3>
              <p class="text-body text-sm">One gift, one place. Nothing sits stranded halfway to a goal, and no project gets overfunded while another waits.</p>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">We deploy where it's needed most</h3>
              <p class="text-body text-sm">Equipment is purchased, delivered, and installed. Staff are trained. Sessions begin — at the facility that's ready first.</p>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">You see where it went</h3>
              <p class="text-body text-sm">Progress reports with real data. Session counts. Symptom reduction. Stories from the field. Named projects, tracked from funded to running.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-light section-padding">
    <div class="container-narrow">
      <p class="label text-primary mb-6">Projects</p>
      <h2 class="mb-4">Where the fund goes.</h2>
      <p class="text-body text-lg max-w-2xl mb-10 leading-relaxed">
        Every project below is funded out of the same pool. This is the work your giving is paying for right now.
      </p>
      <ProjectBrowser
        projects={projects}
        layout="carousel"
        filters="type"
        label="Projects the fund pays for"
      />

      <div class="mt-10">
        <a href="/projects" class="btn-primary">See every project</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-deep text-white section-padding text-center">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-white text-3xl md:text-4xl mb-6">Ready to fund restoration?</h2>
        <p class="text-white/80 mb-10">
          Give once or monthly. Your gift joins the fund that keeps this technology moving into the facilities that need it — and you'll get reports from the field as deployments progress.
        </p>
        <DonateButton label="Donate now" class="btn-gold text-lg" />
        <p class="text-white/60 text-sm mt-6 max-w-md mx-auto leading-relaxed">
          At checkout you can choose to cover the processing fee. It's optional — it just means your full gift reaches the field instead of a slice going to the card networks.
        </p>
        <p class="text-white/70 text-sm mt-4">
          Planning a larger gift, or giving another way?
          <a href="mailto:dallas@restorethelast.org" class="underline hover:text-white/70 transition-colors">Email us</a>
          and we'll walk you through it.
        </p>

        <!-- Catches readers who make it to the bottom of the giving page but aren't ready yet. -->
        <div class="mt-12 pt-10 border-t border-white/10 text-left">
          <NewsletterSignup
            formId="give-newsletter"
            variant="dark"
            heading="Not ready to give today?"
            body="Get Field Notes instead — the story of every deployment, straight from the facilities. See where the money goes before you decide. One email a month."
          />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
