---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateButton from '../components/DonateButton.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import { getProjects } from '../data/projects.js';

const projects = await getProjects();
---

<BaseLayout title="Give" description="Every dollar reaches the field. Give to a specific project, or to the fund that puts neurofeedback in the hands of the people who need it most.">

  <!-- Hero -->
  <section class="bg-white pt-10 pb-8 md:pt-16 md:pb-10 border-b border-primary/10">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Give</p>
      <div class="gold-line mb-8"></div>
      <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight max-w-3xl">
        Every dollar reaches the field.
      </h1>
      <p class="text-body text-lg max-w-2xl mt-6 leading-relaxed">
        Give to a specific project, or into the fund behind all of them — either way, your gift goes straight back out to the facilities doing the work. We name every project it touches and report what changed.
      </p>
      <div class="mt-8">
        <DonateButton label="Donate now" class="btn-gold text-lg" />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="bg-light pt-12 pb-20">
    <div class="container-narrow">
      <p class="label text-primary mb-4 md:mb-6">Projects</p>
      <h2 class="mb-4">Where the fund goes.</h2>
      <p class="text-body text-base md:text-lg max-w-2xl mb-6 md:mb-8 leading-relaxed">
        This is the work your giving is paying for right now. Open any project to give to it directly — or give to the fund and we'll send your gift wherever it's needed most.
      </p>
      <ProjectBrowser
        projects={projects}
        layout="carousel"
        filters="type"
        label="Projects the fund pays for"
      />

      {/* The general-fund ask, sitting directly under the projects it pays for.
          Projects with their own give link take designated gifts on their detail
          pages; this box is for the donor who'd rather not pick — one gift,
          moved to whatever is ready first. */}
      <div class="mt-10 bg-white rounded-2xl border border-primary/20 shadow-sm p-6 md:p-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="max-w-xl">
            <h3 class="text-xl md:text-2xl font-serif font-bold text-dark mb-3">
              Can't pick one? You don't have to.
            </h3>
            <p class="text-body leading-relaxed">
              Give to the fund and we move your gift to whatever is ready first — the projects above, and the ones we haven't announced yet. Nothing sits stranded waiting for a goal to be met.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 lg:flex-shrink-0">
            <DonateButton label="Give to the fund" class="btn-gold text-center whitespace-nowrap" />
            <a href="/projects" class="btn-primary text-center whitespace-nowrap">See every project</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How Giving Works -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <div class="max-w-3xl">
        <p class="label text-primary mb-6">How Giving Works</p>
        <h2 class="mb-8">Two ways to give. Named destinations. Real reports.</h2>
        <p class="text-body text-lg leading-relaxed mb-8">
          Give to a project and your gift is designated to that work. Give to the fund and we move fast the moment a facility is ready — that's the difference between a machine sitting in a closet and a machine running sessions next month. What never changes is the accounting: every project is named publicly, with outcomes attached.
        </p>
        <div class="bg-white rounded-2xl p-6 border-l-4 border-gold-deep border border-primary/10 mb-8">
          <p class="text-body text-sm leading-relaxed">
            <strong class="text-dark">How "every dollar reaches the field" is actually true:</strong> our founders and board cover Restore the Last's operating costs out of their own pockets. Donations only ever pay for the work itself — equipment, training, and support at partner facilities.
          </p>
        </div>
        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">You give — to a project, or to the fund</h3>
              <p class="text-body text-sm">Pick a project and your gift is designated to that work. Give to the fund and we put it wherever it's needed most. Both are published — real facilities, real populations, real costs.</p>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">We deploy where it's needed most</h3>
              <p class="text-body text-sm">Equipment is purchased, delivered, and installed. Staff are trained. Sessions begin — at the facility that's ready first.</p>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-primary/10 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-light border border-primary/20 flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="text-h4 font-serif font-bold mb-1">You see where it went</h3>
              <p class="text-body text-sm">Progress reports with real data. Session counts. Symptom reduction. Stories from the field. Named projects, tracked from funded to running.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- For nonprofits: the other side of the giving equation -->
  <section class="bg-light py-14">
    <div class="container-narrow">
      <div class="bg-white rounded-2xl border border-primary/20 shadow-sm p-6 md:p-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="max-w-xl">
            <p class="label text-primary mb-3">For Nonprofits</p>
            <h3 class="text-xl md:text-2xl font-serif font-bold text-dark mb-3">
              Serving the last? We'll equip you.
            </h3>
            <p class="text-body leading-relaxed">
              If your organization serves trauma-affected people — trafficking survivors, foster youth, communities in crisis — we fund the technology, the training, and the ongoing support to bring nervous system restoration into your work.
            </p>
          </div>
          <div class="lg:flex-shrink-0">
            <a href="/apply" class="btn-primary text-center whitespace-nowrap">Apply for funding</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-deep text-white section-padding text-center">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-white text-3xl md:text-4xl mb-6">Ready to fund restoration?</h2>
        <p class="text-white/80 mb-10">
          Give once or monthly. Your gift joins the fund that keeps this technology moving into the facilities that need it — and you'll get reports from the field as deployments progress.
        </p>
        <DonateButton label="Donate now" class="btn-gold text-lg" />
        <p class="text-white/60 text-sm mt-6 max-w-md mx-auto leading-relaxed">
          At checkout you can choose to cover the processing fee. It's optional — it just means your full gift reaches the field instead of a slice going to the card networks.
        </p>
        <p class="text-white/70 text-sm mt-4">
          Planning a larger gift, or giving another way?
          <a href="mailto:dallas@restorethelast.org" class="underline hover:text-white/70 transition-colors">Email us</a>
          and we'll walk you through it.
        </p>

        <!-- Catches readers who make it to the bottom of the giving page but aren't ready yet. -->
        <div class="mt-12 pt-10 border-t border-white/10 text-left">
          <NewsletterSignup
            formId="give-newsletter"
            variant="dark"
            heading="Not ready to give today?"
            body="Get Field Notes instead — the story of every deployment, straight from the facilities. See where the money goes before you decide. One email a month."
          />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
