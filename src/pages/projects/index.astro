  <div
    data-sticky-cta
    class="md:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 motion-reduce:transition-none bg-white/95 backdrop-blur border-t border-primary/10 px-4 pt-3"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
    aria-hidden="true"
  >
    <a href="#projects" class="btn-gold block w-full text-center" tabindex="-1">Fund a CalmBox · $300</a>
