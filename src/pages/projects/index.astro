---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import { getProjects } from '../../data/projects.js';

const projects = await getProjects();
---

<BaseLayout title="Current Projects" description="The work we're funding right now — deployments in the field, films that carry the story. Give to one directly, or to the fund behind them all.">

  <!-- Hero -->
  <section class="bg-white section-padding border-b border-primary/10">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Current Projects</p>
      <div class="gold-line mb-8"></div>
      <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight max-w-3xl">
        The work we're funding right now.
      </h1>
      <p class="text-body text-lg max-w-2xl mt-6 leading-relaxed">
        Open any project to give to that work directly, or give to the fund behind them all. Some projects are ongoing deployments where there's always more need than funding. Others are fully-costed pieces of work that close the moment they're covered. We publish all of it so you can see exactly what your giving is moving.
      </p>
    </div>
  </section>

  <!-- Browser -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <h2 class="mb-8">Everything we're funding.</h2>
      <ProjectBrowser
        projects={projects}
        layout="grid"
        filters="all"
        label="All projects"
      />
    </div>
  </section>

  <!-- Partner CTA -->
  <section class="bg-white section-padding border-t border-primary/10">
    <div class="container-narrow">
      <div class="max-w-3xl text-center mx-auto">
        <p class="label text-primary mb-4">Are You an Organization?</p>
        <h2 class="mb-6">Apply to become a funded partner.</h2>
        <p class="text-body text-lg leading-relaxed mb-8">
          If you run an established facility serving trauma-affected populations, we want to hear from you. We fund the technology, the training, and the support — you bring the people and the commitment.
        </p>
        <a href="/apply" class="btn-primary text-lg">Apply for funding</a>
      </div>
    </div>
  </section>

</BaseLayout>
