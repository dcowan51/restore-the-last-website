<script>
  // Share: the phone's own share sheet where there is one, a copied link
  // everywhere else. Strips any #anchor so people always land at the top.
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    const status = document.querySelector('[data-share-status]');
    btn.addEventListener('click', async () => {
      const url = location.href.split('#')[0];
      const data = {
        title: 'Restore the Last',
        text: "They're safe now. So why can't they sleep? Here's what $300 does about it.",
        url,
      };
      if (navigator.share) {
        try { await navigator.share(data); } catch { /* closed the sheet */ }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link copied. Paste it into a text or email.';
      } catch {
        window.prompt('Copy this link:', url);
      }
    });
  });

  // Sticky phone CTA: shown only while none of the places that already carry
  // the ask (hero, projects, close, footer) are on screen.
  const stickyBar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  if (stickyBar && 'IntersectionObserver' in window) {
    const stickyLink = stickyBar.querySelector('a');
    const inView = new Map<Element, boolean>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => inView.set(e.target, e.isIntersecting));
      const show = ![...inView.values()].some(Boolean);
      stickyBar.classList.toggle('translate-y-full', !show);
      stickyBar.setAttribute('aria-hidden', String(!show));
      if (stickyLink) stickyLink.tabIndex = show ? 0 : -1;
    });
    // 'body > footer': the quote attributions on this page are <footer>s too.
    ['[data-hero]', '#projects', '[data-close]', 'body > footer']
      .map((sel) => document.querySelector(sel))
      .forEach((el) => el && io.observe(el));
  }

  // Do the Math: the same arithmetic as the frontmatter, re-run on input.
  // Constants arrive as data attributes so the page and the script can't drift.
  document.querySelectorAll<HTMLElement>('[data-impact]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('input[type="range"]');
    const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`);
    const years = Number(root.dataset.years);
    const unitCost = Number(root.dataset.unitCost);
    const smallGift = Number(root.dataset.smallGift);
    let boxes = 1;

    function render() {
      const perWeek = Number(range?.value);
      const sessions = perWeek * 52 * years * boxes;
      const perDollar = sessions / (unitCost * boxes);
      const set = (key: string, text: string) => { const el = out(key); if (el) el.textContent = text; };
      set('uses', `${perWeek} times a week`);
      set('sessions', sessions.toLocaleString('en-US'));
      set('cents', String(Math.round(100 / perDollar)));
      set('small-gift', String(Math.round(perDollar * smallGift)));
      set('formula', `${perWeek} sessions a week × 52 weeks × ${years} years${boxes > 1 ? ` × ${boxes} CalmBoxes` : ''}`);
    }

    range?.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-boxes]').forEach((btn) => {
      btn.addEventListener('click', () => {
        boxes = Number(btn.dataset.boxes);
        root.querySelectorAll('[data-boxes]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        render();
      });
    });
  });

  // Click-to-load video. A YouTube iframe costs ~1MB of script before anyone
  // presses play; the thumbnail costs one image, and the player only loads
  // for people who actually want it.
  document.querySelectorAll<HTMLElement>('.lite-yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      el.replaceChildren(iframe);
    });
  });
</script>

