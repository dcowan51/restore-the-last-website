---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../../config';
---

<BaseLayout
  title="Thank You"
  description="Your project details have been received."
  noindex
>

  <section class="bg-white section-padding border-b border-primary/10">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="label text-primary mb-4">Received</p>
        <div class="gold-line mb-8"></div>
        <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight">
          Thank you. We've got it from here.
        </h1>
        <p class="text-body text-lg mt-6 leading-relaxed">
          We'll turn your answers into a draft project page and send it to you to approve. Nothing goes live until you say it's right.
        </p>
        <p class="text-body mt-4 leading-relaxed">
          Thought of something else? Email
          <a href={`mailto:${CONTACT_EMAIL}`} class="underline text-primary hover:text-medium transition-colors">{CONTACT_EMAIL}</a>.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mt-10">
          <a href="/projects" class="btn-primary text-center">See other projects</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
