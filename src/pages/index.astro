---
import es from '../data/el-salvador.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import { getProjects } from '../data/projects.js';

// The homepage carousel is curated, not exhaustive — flip `featured` on a
// project (in /admin, or its file in src/content/projects/) to change what
// shows here. Falling back to the full list keeps the section from rendering
// empty if every flag is ever turned off.
const projects = await getProjects();
const featured = projects.filter(p => p.featured);
const featuredProjects = featured.length ? featured : projects;
---

<BaseLayout title="Home" description="Restore the Last funds nervous system regulation technology into facilities serving trafficking survivors, foster youth, and children in post-war nations. 18,000+ sessions. 93% improved.">

  <!-- Hero -->
  <section class="bg-white min-h-[56vh] flex items-center">
    <div class="container-narrow w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center py-8 md:py-10">

        <!-- Left: Text -->
        <div>
          <div class="gold-line mb-5 md:mb-6"></div>
          <h1 class="text-dark text-3xl md:text-5xl font-serif font-bold leading-[1.15] mb-4 md:mb-5 max-w-[560px]">
            Trauma lives in the body. Most charities never reach it.
          </h1>
          <p class="text-body text-base md:text-lg max-w-md mb-6 md:mb-8 leading-relaxed">
            Restore the Last places nervous system regulation technology inside the facilities already serving the people hardest to heal —
            <span class="text-primary font-bold">the least, the lost, and the last.</span>
          </p>
          <div class="flex flex-wrap items-center gap-4 mb-6 md:mb-8">
            <a href="/how-it-works" class="btn-primary text-base">See the work</a>
            <a href="/give" class="text-primary font-bold font-sans hover:text-medium transition-colors inline-block py-3">Give now →</a>
          </div>

          <!-- Proof card -->
          <div class="flex items-center gap-4 bg-light rounded-xl p-4 max-w-sm">
            <img src="/placeholder-young-adults.jpg" alt="Direct neurofeedback in action" class="w-12 h-12 md:w-14 md:h-14 rounded-lg object-cover flex-shrink-0" />
            <div>
              <p class="text-primary font-bold font-sans text-sm">18,000+ sessions delivered</p>
              <p class="text-body text-xs mt-1">Across partner facilities in El Salvador and Arizona</p>
            </div>
          </div>
        </div>

        <!-- Right: Photo -->
        <div class="hidden md:block">
          <img
            src="/placeholder-children-playful.jpg"
            alt="Children — illustrative photo representing the populations we serve"
            class="w-full rounded-2xl shadow-xl object-cover object-top"
            style="height: 420px;"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="mb-5 md:mb-6">They got rescued. Their nervous systems didn't.</h2>
        <p class="text-body text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Sex trafficking survivors, foster youth, and children in post-war nations carry trauma in their bodies. Aid reaches them. Healing rarely does.
        </p>
      </div>
    </div>
  </section>

  <!-- Proof Bar -->
  <!-- Live proof band. The three headline figures beside the actual curve they
       came from, so the homepage shows the work rather than asserting it. The
       chart is a static build-time SVG - no library, no runtime fetch - and it
       links through to the full case study rather than trying to be it. -->
  <section class="bg-light border-y border-primary/10 py-10 md:py-14 px-6">
    <div class="max-w-5xl mx-auto grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-8 md:gap-12 items-center">

      <div class="grid grid-cols-3 md:grid-cols-1 gap-6 md:gap-7 text-center md:text-left">
        <div>
          <p class="font-serif text-3xl md:text-5xl font-bold text-primary mb-1 md:mb-2">93%</p>
          <p class="text-dark font-semibold text-sm">showed improvement</p>
          <p class="text-body/80 text-xs mt-0.5">26 of 28 participants</p>
        </div>
        <div>
          <p class="font-serif text-3xl md:text-5xl font-bold text-primary mb-1 md:mb-2">49%</p>
          <p class="text-dark font-semibold text-sm">symptom reduction</p>
          <p class="text-body/80 text-xs mt-0.5">after a single session</p>
        </div>
        <div>
          <p class="font-serif text-3xl md:text-5xl font-bold text-primary mb-1 md:mb-2">18,000+</p>
          <p class="text-dark font-semibold text-sm">sessions delivered</p>
          <p class="text-body/80 text-xs mt-0.5">across the El Salvador deployment</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-primary/10 p-5 md:p-6">
        <p class="label text-primary mb-1">La Casa de mi Padre &middot; El Salvador</p>
        <p class="text-dark font-semibold text-sm mb-4">Symptom score across seven sessions</p>
        <svg viewBox="0 0 420 168" class="w-full h-auto" role="img"
             aria-label="Mean composite symptom score falling from 16.7 at session one to 1.8 at session seven.">
          {[0, 6, 12, 18].map((t) => (
            <line x1="30" x2="404" y1={16 + (1 - t / 18) * 106} y2={16 + (1 - t / 18) * 106}
                  stroke="#712BBE" stroke-opacity="0.12" stroke-width="1" />
          ))}
          <path
            d={[1,2,3,4,5,6,7].map((n, i) => {
              const v = es.curve_balanced[n].mean;
              return `${i ? 'L' : 'M'}${30 + ((n - 1) / 6) * 374},${16 + (1 - v / 18) * 106}`;
            }).join(' ')}
            fill="none" stroke="#712BBE" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          {[1,2,3,4,5,6,7].map((n) => {
            const v = es.curve_balanced[n].mean;
            return (
              <g>
                <circle cx={30 + ((n - 1) / 6) * 374} cy={16 + (1 - v / 18) * 106} r="4"
                        fill="#712BBE" stroke="#FFFFFF" stroke-width="2" />
                <text x={30 + ((n - 1) / 6) * 374} y="150" text-anchor="middle" font-size="10"
                      fill="#3D3D4F" font-weight="700">S{n}</text>
              </g>
            );
          })}
          <text x="30" y="10" font-size="12" font-weight="700" fill="#3A1470"
                style="font-variant-numeric:tabular-nums">16.7</text>
          <text x="404" y={16 + (1 - es.curve_balanced[7].mean / 18) * 106 - 8} text-anchor="end"
                font-size="12" font-weight="700" fill="#3A1470"
                style="font-variant-numeric:tabular-nums">1.8</text>
          <text x="30" y="165" font-size="9" fill="#3D3D4F" opacity="0.6">Mean of 5 symptoms, 0&ndash;50 &middot; same 19 people at every session</text>
        </svg>
        <a href="/impact/el-salvador" class="inline-block mt-4 text-primary font-sans font-bold text-sm hover:text-medium">
          See the full case study &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Current Projects -->
  <section class="bg-white section-padding">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <p class="label text-primary mb-2 md:mb-3">Current Projects</p>
          <h2 class="mb-3">The work your giving is paying for.</h2>
          <p class="text-body text-base md:text-lg leading-relaxed">
            Named projects, real places, published costs. Give to one directly, or through the fund that backs them all.
          </p>
        </div>
        <a href="/projects" class="text-primary font-bold font-sans hover:text-medium transition-colors whitespace-nowrap py-3 md:py-2">
          See all projects →
        </a>
      </div>

      <ProjectBrowser
        projects={featuredProjects}
        layout="carousel"
        label="Featured projects"
        compact={true}
        teaser={true}
      />
    </div>
  </section>

  <!-- Who We Serve -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Who We're Reaching For</p>
      <h2 class="mb-4">The people hardest for the system to reach.</h2>
      <p class="text-body text-base md:text-lg max-w-2xl mb-10 md:mb-12 leading-relaxed">These are the people we're working to reach — nervous systems carrying trauma that talk therapy rarely touches.</p>
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200">
          <div class="w-10 h-10 rounded-full bg-light flex items-center justify-center mb-5">
            <div class="w-3 h-3 rounded-full bg-primary"></div>
          </div>
          <h3 class="text-xl mb-3">Sex Trafficking Survivors</h3>
          <p class="text-body text-sm leading-relaxed">
            Survivors carry trauma in their nervous systems long after rescue. We want to get this technology into organizations already serving them.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200">
          <div class="w-10 h-10 rounded-full bg-light flex items-center justify-center mb-5">
            <div class="w-3 h-3 rounded-full bg-primary"></div>
          </div>
          <h3 class="text-xl mb-3">Foster Youth</h3>
          <p class="text-body text-sm leading-relaxed">
            Aged-out foster youth face the world with nervous systems still stuck in survival mode. We want to equip more of the organizations that house and support them.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200">
          <div class="w-10 h-10 rounded-full bg-light flex items-center justify-center mb-5">
            <div class="w-3 h-3 rounded-full bg-primary"></div>
          </div>
          <h3 class="text-xl mb-3">Developing Nations</h3>
          <p class="text-body text-sm leading-relaxed">
            In countries rebuilding from violence and poverty, trauma is generational. We want to place technology where traditional therapy cannot reach.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Model -->
  <section class="bg-light section-padding">
    <div class="container-narrow">
      <p class="label text-primary mb-4">The Model</p>
      <h2 class="mb-10 md:mb-12">Five steps. One mission.</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-5">
        <div class="bg-white rounded-2xl p-5 md:p-6 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200 text-left col-span-2 md:col-span-1">
          <p class="font-serif text-2xl md:text-4xl font-bold text-primary/20 mb-3 md:mb-4" aria-hidden="true">01</p>
          <p class="font-serif text-base md:text-lg font-bold text-dark mb-2 md:mb-3">Find Projects</p>
          <p class="text-body text-sm leading-relaxed">We find organizations where this technology can do the most good, then build a practical plan with them.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 md:p-6 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200 text-left">
          <p class="font-serif text-2xl md:text-4xl font-bold text-primary/20 mb-3 md:mb-4" aria-hidden="true">02</p>
          <p class="font-serif text-base md:text-lg font-bold text-dark mb-2 md:mb-3">Fund</p>
          <p class="text-body text-sm leading-relaxed">Donors give to a specific project, or to one shared fund — with full transparency into everything it pays for.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 md:p-6 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200 text-left">
          <p class="font-serif text-2xl md:text-4xl font-bold text-primary/20 mb-3 md:mb-4" aria-hidden="true">03</p>
          <p class="font-serif text-base md:text-lg font-bold text-dark mb-2 md:mb-3">Deploy</p>
          <p class="text-body text-sm leading-relaxed">We place neurofeedback technology directly into partner facilities where it is needed most.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 md:p-6 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200 text-left">
          <p class="font-serif text-2xl md:text-4xl font-bold text-primary/20 mb-3 md:mb-4" aria-hidden="true">04</p>
          <p class="font-serif text-base md:text-lg font-bold text-dark mb-2 md:mb-3">Train</p>
          <p class="text-body text-sm leading-relaxed">On-site staff receive hands-on training so they can deliver sessions with confidence and consistency.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 md:p-6 border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all duration-200 text-left">
          <p class="font-serif text-2xl md:text-4xl font-bold text-primary/20 mb-3 md:mb-4" aria-hidden="true">05</p>
          <p class="font-serif text-base md:text-lg font-bold text-dark mb-2 md:mb-3">Support</p>
          <p class="text-body text-sm leading-relaxed">We don't walk away after deployment. Ongoing support and resources help each partner succeed long term.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pull Quote -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <div class="flex items-start gap-6 max-w-3xl">
        <div class="gold-line-left flex-shrink-0 hidden md:block"></div>
        <blockquote class="font-serif italic text-xl md:text-3xl text-dark leading-snug">
          The technology exists. The need exists. The distance between them is what we close.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Where It's Working: proof + field video, one beat per partner -->
  <section class="bg-white section-padding">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Where It's Working</p>
      <h2 class="mb-4">Proof, not promises.</h2>
      <p class="text-body text-base md:text-lg max-w-xl mb-10 md:mb-12 leading-relaxed">
        These are the people doing the work — and the numbers they're producing. Hear it directly from the field.
      </p>
      <div class="grid md:grid-cols-2 gap-10 md:gap-12">

        <!-- La Casa de mi Padre -->
        <div class="flex flex-col">
          <p class="label text-gold-deep mb-2">La Casa de mi Padre</p>
          <p class="text-sm text-body/80 mb-4">El Salvador — children's home</p>
          <p class="font-serif text-2xl md:text-3xl font-bold text-primary mb-4">93% showed improvement</p>
          <p class="text-body mb-6">
            29 participants over a 23-day protocol in autumn 2022. Symptoms fell 49% after a single session and 74% by each participant's final session. Children, house parents, and on-site staff — all carrying trauma, all showing measurable recovery. That study sits inside a deployment that has since delivered more than 18,000 sessions.
          </p>
          <div class="mt-auto bg-offwhite rounded-2xl overflow-hidden border border-primary/10 shadow-sm">
            <div class="aspect-video">
              <iframe
                src="https://www.youtube-nocookie.com/embed/uTvgBmxbzeQ"
                title="El Salvador — Restore the Last"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="w-full h-full"
                loading="lazy"
              ></iframe>
            </div>
            <div class="p-4 md:p-5">
              <p class="text-body text-sm">Footage from our partner sites in El Salvador, narrated by the on-site psychologist at our partner school ONUVA.</p>
            </div>
          </div>
        </div>

        <!-- Thrive -->
        <div class="flex flex-col">
          <p class="label text-gold-deep mb-2">Thrive</p>
          <p class="text-sm text-body/80 mb-4">Arizona, USA</p>
          <p class="font-serif text-2xl md:text-3xl font-bold text-primary mb-4">25–30 sessions/week</p>
          <p class="text-body mb-6">
            Aged-out foster youth, ages 18–25. Residents are sleeping through the night. Ten earned their driver's licenses. Five graduated high school. The nervous system calmed down — and everything else followed.
          </p>
          <div class="mt-auto bg-offwhite rounded-2xl overflow-hidden border border-primary/10 shadow-sm">
            <div class="aspect-video">
              <iframe
                src="https://www.youtube-nocookie.com/embed/utLjfuTNIU8"
                title="Thrive Arizona — Restore the Last"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="w-full h-full"
                loading="lazy"
              ></iframe>
            </div>
            <div class="p-4 md:p-5">
              <p class="text-body text-sm">Aged-out foster youth. Hear directly from Steve Vogel, President & CEO.</p>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-8 md:mt-10 text-center">
        <a href="/partners" class="btn-primary">See all our partners</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-deep text-white section-padding">
    <div class="container-narrow text-center">
      <h2 class="text-white text-2xl md:text-4xl mb-5 md:mb-6">Every dollar reaches the field.</h2>
      <p class="text-white/80 max-w-xl mx-auto mb-8 md:mb-10">
        You see where your gift goes, who it reaches, and what changes. No black boxes — our founders and board cover the overhead, so donations only ever pay for the work.
      </p>
      <a href="/give" class="btn-gold text-lg">Give now</a>

      <!-- Secondary ask: the low-commitment step for readers who aren't ready to give. -->
      <div class="mt-12 md:mt-14 pt-10 border-t border-white/10 max-w-lg mx-auto text-left">
        <NewsletterSignup
          formId="home-newsletter"
          variant="dark"
          heading="Not ready to give? Follow the work."
          body="Field Notes — the story of every deployment, straight from the facilities. One email a month."
        />
      </div>
    </div>
  </section>

</BaseLayout>
