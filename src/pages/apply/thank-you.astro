---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../../config';
---

<BaseLayout
  title="Application Received"
  description="Your funding application has been received. Someone from Restore the Last will be in contact with you."
>

  <section class="bg-white section-padding border-b border-primary/10">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="label text-primary mb-4">Application Received</p>
        <div class="gold-line mb-8"></div>
        <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight">
          Thank you. We got it.
        </h1>
        <p class="text-body text-lg mt-6 leading-relaxed">
          Thank you for the work you're doing — and for trusting us with this. We read every application personally, and someone from Restore the Last will be in contact with you soon.
        </p>
        <p class="text-body mt-4 leading-relaxed">
          Have something to add in the meantime? Email
          <a href={`mailto:${CONTACT_EMAIL}`} class="underline text-primary hover:text-medium transition-colors">{CONTACT_EMAIL}</a>.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mt-10">
          <a href="/projects" class="btn-primary text-center">See what a deployment looks like</a>
          <a href="/" class="btn-gold text-center">Back to home</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
