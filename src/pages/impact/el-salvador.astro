---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/el-salvador.json';

// Every figure on this page comes from src/data/el-salvador.json, which is
// generated by analysis/analyze.py from Tiffany Lewis's tracking workbook.
// Nothing here is hand-typed. If a number looks wrong, fix the analysis and
// regenerate - do not edit this file.

const H = data.headline;
const C = data.counts;

// ---------------------------------------------------------------------------
// Chart 1 - session curve.
// Single series (the composite score), so no legend: the title names it.
// One axis. Solid hairline grid. n printed at every point, because the sample
// narrows and hiding that would be the whole problem we are fixing.
// ---------------------------------------------------------------------------
const SESSIONS = [1, 2, 3, 4, 5, 6, 7];
const curves = {
  balanced: SESSIONS.map((s) => ({ s, ...(data.curve_balanced[s] ?? {}) })).filter((d) => d.mean != null),
  all: SESSIONS.map((s) => ({ s, ...(data.curve_all[s] ?? {}) })).filter((d) => d.mean != null),
};

const CW = 720, CH = 300, CM = { t: 28, r: 28, b: 52, l: 44 };
const yMax = 18;
const cx = (s) => CM.l + ((s - 1) / 6) * (CW - CM.l - CM.r);
const cy = (v) => CM.t + (1 - v / yMax) * (CH - CM.t - CM.b);
const pathOf = (pts) => pts.map((p, i) => `${i ? 'L' : 'M'}${cx(p.s).toFixed(1)},${cy(p.mean).toFixed(1)}`).join(' ');
const yTicks = [0, 5, 10, 15];

// ---------------------------------------------------------------------------
// Chart 2 - symptom domains, baseline to final. A dumbbell: before/after per
// item, one hue in two validated shades (#A87BDF -> #712BBE).
// ---------------------------------------------------------------------------
const domains = Object.entries(data.domains)
  .map(([name, d]) => ({ name: name === 'Migraine/Other' ? 'Migraine / other' : name, ...d }))
  .sort((a, b) => b.reduction_pct - a.reduction_pct);
const DW = 720, DROW = 44, DL = 132, DR = 128;
const dx = (v) => DL + (v / 6) * (DW - DL - DR);

// ---------------------------------------------------------------------------
// Chart 3 - every participant, ranked. Diverging about zero: reduction in
// primary purple, the one participant who ended worse in gold-deep.
// ---------------------------------------------------------------------------
const ranked = data.ranked;
// Thin marks: 11px bars with a 6px gap read calm across 28 rows where 16px reads
// as a wall of purple. Domain runs -20..100 so the single negative bar has room
// without surrendering a fifth of the plot to empty space.
const RW = 720, RBAR = 11, RGAP = 6, RL = 46, RR = 52;
const R_MIN = -20, R_MAX = 100;
const rx = (v) => RL + ((v - R_MIN) / (R_MAX - R_MIN)) * (RW - RL - RR);
const rZero = rx(0);
const R_TOP = 26;
const RH = R_TOP + ranked.length * (RBAR + RGAP) + 6;

// ---------------------------------------------------------------------------
// Chart 4 - how long each session's effect held.
// ---------------------------------------------------------------------------
const dur = Object.entries(data.duration).map(([k, v]) => ({
  session: Number(k.replace('after_S', '')), ...v,
}));
const durMax = 8;

const pageTitle = 'El Salvador Case Study';
const pageDesc =
  'Twenty-nine people, seven sessions, twenty-three days at a children’s home in El Salvador. Symptoms fell 49% after a single session and 74% by each participant’s final session. Full data, including what didn’t work.';
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- ===================== HERO ===================== -->
  <section class="bg-white section-padding border-b border-primary/10">
    <div class="container-narrow">
      <p class="label text-primary mb-4">Case Study &middot; El Salvador</p>
      <div class="gold-line mb-8"></div>
      <h1 class="text-dark text-4xl md:text-5xl font-serif font-bold leading-tight max-w-3xl mb-6">
        Symptoms fell by half after one session.
      </h1>
      <p class="text-body text-lg md:text-xl leading-relaxed max-w-2xl mb-4">
        Twenty-nine people at a children&rsquo;s home in El Salvador. Seven sessions over
        twenty-three days. Below is everything we measured &mdash; including the parts that
        didn&rsquo;t work.
      </p>
      <p class="text-body/80 text-sm max-w-2xl">
        Autumn 2022 &middot; La Casa de mi Padre and ONUVA &middot; delivered by Tiffany Lewis, LMFT
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-primary/10 border border-primary/10 rounded-2xl overflow-hidden mt-10">
        <div class="bg-white p-5 md:p-6">
          <p class="font-serif text-3xl md:text-4xl font-bold text-primary">{C.participants}</p>
          <p class="text-dark font-semibold text-sm mt-1">participants</p>
          <p class="text-body/80 text-xs mt-1">children, house parents, teachers</p>
        </div>
        <div class="bg-white p-5 md:p-6">
          <p class="font-serif text-3xl md:text-4xl font-bold text-primary">{H.improved} of {H.scored_denominator}</p>
          <p class="text-dark font-semibold text-sm mt-1">improved</p>
          <p class="text-body/80 text-xs mt-1">{H.improved_pct}% of those scored</p>
        </div>
        <div class="bg-white p-5 md:p-6">
          <p class="font-serif text-3xl md:text-4xl font-bold text-primary">{Math.round(H.mean_reduction_S1_to_S2_pct)}%</p>
          <p class="text-dark font-semibold text-sm mt-1">after one session</p>
          <p class="text-body/80 text-xs mt-1">mean symptom reduction</p>
        </div>
        <div class="bg-white p-5 md:p-6">
          <p class="font-serif text-3xl md:text-4xl font-bold text-primary">{Math.round(H.mean_reduction_baseline_to_final_pct)}%</p>
          <p class="text-dark font-semibold text-sm mt-1">by final session</p>
          <p class="text-body/80 text-xs mt-1">mean reduction from baseline</p>
        </div>
      </div>
      <p class="text-body/80 text-xs mt-4 max-w-2xl">
        Two of the twenty-nine sit outside that denominator: one recorded no symptoms at any
        session, and one finished above where they started. Both are shown in full below.
      </p>
    </div>
  </section>

  <!-- ===================== THE PLACE ===================== -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow grid md:grid-cols-[1fr_340px] gap-12 items-start">
      <div>
        <p class="label text-gold-deep mb-2">The Setting</p>
        <h2 class="mb-6">Everyone in the building was carrying something.</h2>
        <p class="text-body text-lg leading-relaxed mb-4">
          La Casa de mi Padre is a children&rsquo;s home in El Salvador. The courts place
          children there after abuse, neglect, or abandonment. Three houses, roughly eight
          children in each, ages two to seventeen &mdash; alongside house parents, teachers, and
          support staff at the partner school, ONUVA.
        </p>
        <p class="text-body text-lg leading-relaxed mb-4">
          The adults were carrying their own histories while holding the children&rsquo;s. That
          is why the study enrolled both. If regulation only reaches the children, it is
          working against the room.
        </p>
        <p class="text-body leading-relaxed">
          More than half of Salvadoran young people have been exposed to significant trauma.
          Talk therapy, where it exists at all, asks for language, months, and money. This
          asked for none of those.
        </p>
      </div>
      <div class="bg-white rounded-2xl border border-primary/10 p-6 md:p-7">
        <p class="label text-primary mb-3">What Direct Neurofeedback is</p>
        <p class="text-body text-sm leading-relaxed mb-3">
          A very small signal is delivered through sensors on the scalp. It is painless and
          usually not even noticeable. The brain detects it and self-corrects, releasing
          patterns it has been stuck in.
        </p>
        <p class="text-body text-sm leading-relaxed mb-3">
          Sessions run about thirty minutes. There is nothing to say and nothing to relive
          &mdash; which is why it reaches people talk therapy cannot: toddlers, non-verbal
          children, anyone who has run out of willingness to tell the story again.
        </p>
        <p class="text-body/80 text-xs leading-relaxed">
          Participants rated five symptoms &mdash; anxiety, insomnia, anger, depression, and
          migraine or other physical complaints &mdash; from 0 to 10 before each session. The
          composite score is those five added together, so it runs 0 to 50.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== THE CURVE ===================== -->
  <section class="bg-white section-padding border-t border-primary/10">
    <div class="container-narrow">
      <p class="label text-gold-deep mb-2">The Results</p>
      <h2 class="mb-4">Most of the change happened in the first week.</h2>
      <p class="text-body text-lg leading-relaxed max-w-2xl mb-2">
        The composite symptom score, averaged across everyone who attended each session. The
        steepest drop is between session one and session two &mdash; a mean reduction of
        {H.mean_reduction_S1_to_S2_pct}%, measured a week later rather than in the moment.
      </p>
      <p class="text-body/80 text-sm max-w-2xl mb-8">
        Ratings were taken <em>before</em> each session, so every drop shown here is what
        carried over between sessions, not how someone felt walking out of one.
      </p>

      <div class="bg-offwhite rounded-2xl border border-primary/10 p-4 md:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <p class="text-dark font-semibold text-sm">Mean composite symptom score (0&ndash;50)</p>
          <div class="inline-flex rounded-lg border border-primary/20 overflow-hidden text-xs font-sans font-bold" role="group" aria-label="Choose cohort">
            <button type="button" data-cohort="balanced" aria-pressed="true"
              class="cohort-btn px-3 py-2 bg-primary text-white">The same 19 people</button>
            <button type="button" data-cohort="all" aria-pressed="false"
              class="cohort-btn px-3 py-2 bg-white text-body hover:bg-light">Everyone who attended</button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <svg id="curve" viewBox={`0 0 ${CW} ${CH}`} class="w-full min-w-[560px] h-auto" role="img"
               aria-label="Line chart of mean composite symptom score across seven sessions.">
            <!-- grid: solid hairlines, one shade off the surface -->
            {yTicks.map((t) => (
              <g>
                <line x1={CM.l} x2={CW - CM.r} y1={cy(t)} y2={cy(t)} stroke="#712BBE" stroke-opacity="0.12" stroke-width="1" />
                <text x={CM.l - 10} y={cy(t) + 4} text-anchor="end" font-size="11" fill="#3D3D4F" opacity="0.7" style="font-variant-numeric:tabular-nums">{t}</text>
              </g>
            ))}
            {SESSIONS.map((s) => (
              <text x={cx(s)} y={CH - 26} text-anchor="middle" font-size="12" fill="#3D3D4F" font-weight="700">S{s}</text>
            ))}

            {(['balanced', 'all'] as const).map((key) => (
              <g class="curve-group" data-cohort={key} style={key === 'all' ? 'display:none' : ''}>
                <path d={pathOf(curves[key])} fill="none" stroke="#712BBE" stroke-width="2"
                      stroke-linejoin="round" stroke-linecap="round" />
                {curves[key].map((p) => (
                  <g>
                    <circle cx={cx(p.s)} cy={cy(p.mean)} r="5" fill="#712BBE" stroke="#FAFAF7" stroke-width="2" />
                    <text x={cx(p.s)} y={CH - 10} text-anchor="middle" font-size="10" fill="#3D3D4F" opacity="0.7">n={p.n}</text>
                  </g>
                ))}
                <!-- selective direct labels: baseline, the session-5 rise, and the endpoint -->
                {curves[key].filter((p) => [1, 5, 7].includes(p.s)).map((p) => (
                  <text x={cx(p.s)} y={cy(p.mean) - 14} text-anchor="middle" font-size="13"
                        font-weight="700" fill="#3A1470" style="font-variant-numeric:tabular-nums">{p.mean.toFixed(2)}</text>
                ))}
              </g>
            ))}

            <!-- hover columns -->
            {SESSIONS.map((s) => (
              <rect class="curve-hit" data-session={s} x={cx(s) - 26} y={CM.t - 14}
                    width="52" height={CH - CM.t - CM.b + 28} fill="transparent" style="cursor:crosshair" />
            ))}
            <line id="curve-cross" x1="0" x2="0" y1={CM.t - 14} y2={CH - CM.b} stroke="#712BBE"
                  stroke-opacity="0.35" stroke-width="1" style="display:none;pointer-events:none" />
          </svg>
        </div>

        <div id="curve-tip" class="mt-3 text-sm text-body min-h-[1.5rem]" aria-live="polite">
          <span class="text-body/80">Hover or tap a session to read its value.</span>
        </div>

        <div class="mt-5 pt-5 border-t border-primary/10">
          <p class="text-body/80 text-sm leading-relaxed">
            <strong class="text-dark">Session five goes the wrong way, and that is the schedule, not the protocol.</strong>
            Sessions were not evenly spaced. Sessions two, four and seven were rated the day
            after the previous session; three, five and six about a week after. Across the whole
            study, scores rose at 44% of week-gap steps and only 14% of next-day steps. The
            benefit was real and it was fading between visits &mdash; which is exactly what the
            next chart is about.
          </p>
        </div>

        <details class="mt-5">
          <summary class="text-sm font-bold text-primary cursor-pointer">View as a table</summary>
          <table class="w-full text-sm mt-3 border-collapse">
            <thead>
              <tr class="text-left border-b border-primary/20">
                <th class="py-2 pr-4 font-semibold text-dark">Session</th>
                <th class="py-2 pr-4 font-semibold text-dark">Same 19 people</th>
                <th class="py-2 pr-4 font-semibold text-dark">Everyone who attended</th>
                <th class="py-2 font-semibold text-dark">n (all)</th>
              </tr>
            </thead>
            <tbody style="font-variant-numeric:tabular-nums">
              {SESSIONS.map((s) => (
                <tr class="border-b border-primary/10">
                  <td class="py-2 pr-4">Session {s}</td>
                  <td class="py-2 pr-4">{data.curve_balanced[s]?.mean ?? '—'}</td>
                  <td class="py-2 pr-4">{data.curve_all[s]?.mean ?? '—'}</td>
                  <td class="py-2">{data.curve_all[s]?.n ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </div>
    </div>
  </section>

  <!-- ===================== DURATION ===================== -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <p class="label text-gold-deep mb-2">Durability</p>
      <h2 class="mb-4">Each session held longer than the one before it.</h2>
      <p class="text-body text-lg leading-relaxed max-w-2xl mb-8">
        The practitioner recorded how long each session&rsquo;s effect lasted. After the first
        session, the benefit held about two days. By the fifth, a week. That is the answer to
        the question funders ask first &mdash; what happens when the sessions stop &mdash; and
        the answer is that people move onto a maintenance schedule rather than a permanent one.
      </p>

      <div class="bg-white rounded-2xl border border-primary/10 p-4 md:p-7 max-w-3xl">
        <p class="text-dark font-semibold text-sm mb-5">Median days the effect held, by session</p>
        <div class="space-y-3">
          {dur.map((d) => (
            <div class="flex items-center gap-3">
              <span class="w-20 shrink-0 text-xs font-bold text-body">After S{d.session}</span>
              <div class="flex-1 h-6 bg-light rounded-r-md relative overflow-hidden">
                <div class="h-full bg-primary rounded-r-md" style={`width:${(d.median_days / durMax) * 100}%`}></div>
              </div>
              <span class="w-24 shrink-0 text-xs text-dark font-bold" style="font-variant-numeric:tabular-nums">
                {d.median_days} days
              </span>
              <span class="w-12 shrink-0 text-xs text-body/80" style="font-variant-numeric:tabular-nums">n={d.n}</span>
            </div>
          ))}
        </div>
        <p class="text-body/80 text-xs leading-relaxed mt-5 pt-5 border-t border-primary/10">
          <strong class="text-dark">Read this as a direction, not a dose curve.</strong> You
          cannot observe an effect lasting longer than the gap before the next measurement, and
          those gaps grew as the study went on. Establishing the real durability needs a
          follow-up study with fixed intervals. We have not run one yet.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== DOMAINS ===================== -->
  <section class="bg-white section-padding border-t border-primary/10">
    <div class="container-narrow">
      <p class="label text-gold-deep mb-2">By Symptom</p>
      <h2 class="mb-4">Sleep moved first and moved furthest.</h2>
      <p class="text-body text-lg leading-relaxed max-w-2xl mb-8">
        Anxiety was the most common complaint at intake. Insomnia was the one that resolved most
        completely &mdash; from a mean of {domains.find((d) => d.name === 'Insomnia')?.baseline_mean} to
        {' '}{domains.find((d) => d.name === 'Insomnia')?.final_mean} out of 10. Children who could
        not sleep in a building where they were finally safe began sleeping through the night.
      </p>

      <div class="bg-offwhite rounded-2xl border border-primary/10 p-4 md:p-7">
        <div class="flex flex-wrap items-center gap-5 mb-5">
          <p class="text-dark font-semibold text-sm mr-auto">Mean rating, first session to last (0&ndash;10)</p>
          <span class="inline-flex items-center gap-2 text-xs text-body">
            <span class="w-3 h-3 rounded-full" style="background:#A87BDF"></span> First session
          </span>
          <span class="inline-flex items-center gap-2 text-xs text-body">
            <span class="w-3 h-3 rounded-full" style="background:#712BBE"></span> Final session
          </span>
        </div>

        <div class="overflow-x-auto">
          <svg viewBox={`0 0 ${DW} ${domains.length * DROW + 40}`} class="w-full min-w-[560px] h-auto" role="img"
               aria-label="Dumbbell chart comparing mean symptom ratings at first and final session.">
            {[0, 2, 4, 6].map((t) => (
              <g>
                <line x1={dx(t)} x2={dx(t)} y1="8" y2={domains.length * DROW + 4} stroke="#712BBE" stroke-opacity="0.12" stroke-width="1" />
                <text x={dx(t)} y={domains.length * DROW + 26} text-anchor="middle" font-size="11" fill="#3D3D4F" opacity="0.7">{t}</text>
              </g>
            ))}
            {domains.map((d, i) => {
              const y = 20 + i * DROW;
              return (
                <g>
                  <text x="0" y={y + 4} font-size="13" fill="#1C1C2E" font-weight="600">{d.name}</text>
                  <line x1={dx(d.final_mean)} x2={dx(d.baseline_mean)} y1={y} y2={y} stroke="#712BBE" stroke-opacity="0.28" stroke-width="2" />
                  <circle cx={dx(d.baseline_mean)} cy={y} r="7" fill="#A87BDF" stroke="#FAFAF7" stroke-width="2" />
                  <circle cx={dx(d.final_mean)} cy={y} r="7" fill="#712BBE" stroke="#FAFAF7" stroke-width="2" />
                  <text x={DW - 62} y={y + 4} text-anchor="end" font-size="13" font-weight="700" fill="#3A1470"
                        style="font-variant-numeric:tabular-nums">&minus;{Math.round(d.reduction_pct)}%</text>
                  <text x={DW - 54} y={y + 4} font-size="10" fill="#3D3D4F" opacity="0.6">n={d.n}</text>
                </g>
              );
            })}
          </svg>
        </div>

        <p class="text-body/80 text-xs leading-relaxed mt-5 pt-5 border-t border-primary/10">
          Symptom-level ratings exist for {C.with_symptom_breakdown} of the {C.participants}
          participants, so these five figures rest on a smaller sample than the headline numbers.
          Each row shows its own n. Only participants who reported a given symptom at intake are
          counted in that row.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== EVERY PARTICIPANT ===================== -->
  <section class="bg-deep text-white section-padding">
    <div class="container-narrow">
      <p class="label text-gold mb-2">Every Participant</p>
      <h2 class="text-white mb-4">Nobody is averaged away.</h2>
      <p class="text-white/80 text-lg leading-relaxed max-w-2xl mb-8">
        Every person in the study, ranked by how far their symptoms fell. Twelve reached zero.
        One finished above where they started. We are showing you that one, because a chart where
        everybody wins is a chart nobody should believe.
      </p>

      <div class="bg-white rounded-2xl p-4 md:p-7">
        <p class="text-dark font-semibold text-sm mb-5">
          Change from first session to last, per participant
        </p>
        <div class="overflow-x-auto">
          <svg viewBox={`0 0 ${RW} ${RH}`} class="w-full min-w-[560px] h-auto" role="img"
               aria-label="Bar chart of symptom reduction for each participant, ranked highest to lowest.">
            {[-20, 0, 25, 50, 75, 100].map((t) => (
              <g>
                <line x1={rx(t)} x2={rx(t)} y1={R_TOP - 12} y2={RH - 4} stroke="#712BBE"
                      stroke-opacity={t === 0 ? '0.45' : '0.1'} stroke-width="1" />
                <text x={rx(t)} y="12" text-anchor="middle" font-size="11" fill="#3D3D4F" opacity="0.7">{t}%</text>
              </g>
            ))}
            {ranked.map((p, i) => {
              const y = R_TOP + i * (RBAR + RGAP);
              const up = p.reduction_pct >= 0;
              const x0 = up ? rZero : rx(p.reduction_pct);
              const w = Math.max(1.5, Math.abs(rx(p.reduction_pct) - rZero));
              return (
                <g class="rank-row" data-pid={p.pid} data-red={p.reduction_pct}
                   data-base={p.baseline} data-final={p.final} data-sessions={p.sessions} style="cursor:pointer">
                  <rect x="0" y={y - 3} width={RW} height={RBAR + 6} fill="transparent" />
                  <text x="0" y={y + RBAR - 1} font-size="10" fill="#3D3D4F" opacity="0.65"
                        style="font-variant-numeric:tabular-nums">P{p.pid}</text>
                  <rect x={x0} y={y} width={w} height={RBAR} rx="4"
                        fill={up ? '#712BBE' : '#A84018'} />
                  <text x={RW - RR + 8} y={y + RBAR - 1} font-size="11"
                        fill={up ? '#3D3D4F' : '#A84018'} font-weight={up ? '400' : '700'}
                        style="font-variant-numeric:tabular-nums">
                    {up ? '' : '+'}{Math.abs(Math.round(p.reduction_pct))}%
                  </text>
                </g>
              );
            })}
          </svg>
        </div>
        <div id="rank-tip" class="mt-3 text-sm text-body min-h-[1.5rem]" aria-live="polite">
          <span class="text-body/80">Hover or tap a bar for that participant&rsquo;s sessions.</span>
        </div>
        <p class="text-body/80 text-xs leading-relaxed mt-5 pt-5 border-t border-primary/10">
          Participants are anonymised and numbered. One further participant recorded zero symptoms
          at every session and cannot be expressed as a percentage change; they are excluded here
          and from the {H.improved_pct}% figure, which is why the denominator is
          {' '}{H.scored_denominator} rather than {C.participants}.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== IN THE ROOM ===================== -->
  <section class="bg-offwhite section-padding">
    <div class="container-narrow">
      <p class="label text-gold-deep mb-2">In the Room</p>
      <h2 class="mb-4">What the numbers were actually made of.</h2>
      <div class="grid md:grid-cols-2 gap-8 md:gap-10 mt-8">
        <div class="bg-white rounded-2xl border border-primary/10 p-6">
          <p class="text-body leading-relaxed">
            A teacher having two to three grand mal seizures a week stopped having them after her
            first session. She did not mention it to the practitioner for three weeks &mdash;
            epilepsy carries stigma &mdash; and put the change down to being more patient in class.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-primary/10 p-6">
          <p class="text-body leading-relaxed">
            A twelve-year-old boy&rsquo;s chronic bedwetting stopped after one session. By session
            four he rated his anger at 8 out of 10. That was not a relapse. It was a boy who had
            been numb starting to feel things again, and it is the clearest example of why a
            symptom score can understate what is happening.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-primary/10 p-6">
          <p class="text-body leading-relaxed">
