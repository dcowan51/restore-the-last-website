  <script type="application/json" id="curve-data" set:html={JSON.stringify(curves)}></script>
  <script is:inline>
    // Cohort toggle - swaps which rendered group is visible. Both are in the DOM,
    // so the chart is complete without JS.
    const groups = document.querySelectorAll('.curve-group');
    document.querySelectorAll('.cohort-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const want = btn.dataset.cohort;
        document.querySelectorAll('.cohort-btn').forEach((b) => {
          const on = b.dataset.cohort === want;
          b.setAttribute('aria-pressed', String(on));
          b.className = 'cohort-btn px-3 py-2 ' + (on ? 'bg-primary text-white' : 'bg-white text-body hover:bg-light');
        });
        groups.forEach((g) => { g.style.display = g.dataset.cohort === want ? '' : 'none'; });
        window.__cohort = want;
      });
    });

    // Crosshair + readout. The tooltip enhances; every value is also in the table view.
    window.__cohort = 'balanced';
    const tip = document.getElementById('curve-tip');
    const cross = document.getElementById('curve-cross');
    const curveData = JSON.parse(document.getElementById('curve-data').textContent);
    document.querySelectorAll('.curve-hit').forEach((hit) => {
      const show = () => {
        const s = Number(hit.dataset.session);
        const row = curveData[window.__cohort].find((d) => d.s === s);
        if (!row) return;
        const x = hit.getAttribute('x') * 1 + hit.getAttribute('width') / 2;
        cross.setAttribute('x1', x); cross.setAttribute('x2', x); cross.style.display = '';
        tip.innerHTML =
          '<strong class="text-dark">Session ' + s + '</strong> &middot; mean ' +
          row.mean.toFixed(2) + ' of 50 &middot; ' + row.n + ' participants';
      };
      hit.addEventListener('mouseenter', show);
      hit.addEventListener('touchstart', show, { passive: true });
      hit.addEventListener('focus', show);
    });
    document.getElementById('curve')?.addEventListener('mouseleave', () => {
      cross.style.display = 'none';
      tip.innerHTML = '<span class="text-body/80">Hover or tap a session to read its value.</span>';
    });

    // Ranked-participant readout.
    const rtip = document.getElementById('rank-tip');
    document.querySelectorAll('.rank-row').forEach((row) => {
      const show = () => {
        const d = row.dataset;
        const dir = Number(d.red) >= 0 ? 'down' : 'up';
        rtip.innerHTML =
          '<strong class="text-dark">Participant ' + d.pid + '</strong> &middot; ' +
          d.sessions + ' sessions &middot; ' + d.base + ' &rarr; ' + d.final +
          ' (' + dir + ' ' + Math.abs(Math.round(d.red)) + '%)';
      };
      row.addEventListener('mouseenter', show);
      row.addEventListener('touchstart', show, { passive: true });
    });
  </script>

