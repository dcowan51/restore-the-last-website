---
import { DONATE_URL } from '../config';
import NewsletterSignup from './NewsletterSignup.astro';

const year = new Date().getFullYear();
---

<footer class="bg-deep text-white">
  <div class="container-narrow py-12 md:py-16">
    <!-- Newsletter -->
    <div class="pb-12 mb-12 border-b border-white/10">
      <div class="max-w-xl">
        <NewsletterSignup formId="footer-newsletter" variant="dark" />
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 md:gap-12">
      <!-- Brand -->
      <div>
        <p class="font-serif text-2xl font-bold text-gold mb-4">Restore the Last</p>
        <p class="text-white/70 text-sm leading-relaxed">
          Funding nervous system restoration for survivors of trafficking, foster care, and violence.
        </p>
      </div>

      <!-- Links -->
      <div>
        <p class="label text-gold mb-4">Navigate</p>
        <div class="flex flex-col gap-2">
          <a href="/about" class="text-white/70 hover:text-white text-sm transition-colors py-3">About</a>
          <a href="/how-it-works" class="text-white/70 hover:text-white text-sm transition-colors py-3">How It Works</a>
          <a href="/impact" class="text-white/70 hover:text-white text-sm transition-colors py-3">Impact</a>
          <a href="/partners" class="text-white/70 hover:text-white text-sm transition-colors py-3">Partners</a>
          <a href="/give" class="text-white/70 hover:text-white text-sm transition-colors py-3">Give</a>
          <a
            href={DONATE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gold hover:brightness-110 text-sm font-bold transition-all py-3"
          >
            Donate now →
          </a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <p class="label text-gold mb-4">Contact</p>
        <a href="mailto:dallas@restorethelast.org" class="text-white/70 hover:text-white text-sm transition-colors py-3 inline-block">
          dallas@restorethelast.org
        </a>
      </div>
    </div>

    <!-- Scripture + Copyright -->
    <div class="mt-16 pt-8 border-t border-white/10 text-center">
      <p class="font-serif italic text-gold text-lg mb-4">
        "He restores my soul." — Psalm 23:3
      </p>
      <p class="text-white/70 text-xs">
        &copy; {year} Restore the Last. All rights reserved.
        <span class="mx-2 text-white/40" aria-hidden="true">·</span>
        <a href="/privacy" class="hover:text-white transition-colors underline inline-block py-3.5">Privacy</a>
      </p>
    </div>
  </div>
</footer>
